# Eseguito a ogni build: scrive OUTPUT solo se la revisione o il flag dirty cambiano.
# Variabili: SOURCE_DIR, OUTPUT, EXPLICIT_REVISION (vuoto per usare git).
if(EXPLICIT_REVISION)
  if(NOT EXPLICIT_REVISION MATCHES "^[A-Za-z0-9._+-]+$")
    message(FATAL_ERROR "ASTRO_SOURCE_REVISION non valido: ammessi [A-Za-z0-9._+-]")
  endif()
  set(revision "${EXPLICIT_REVISION}")
  set(dirty_known "false")
  set(dirty "false")
else()
  execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc ERROR_QUIET)
  if(NOT rc EQUAL 0 OR NOT revision MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Revisione del sorgente non determinabile: non e' un checkout git. Passare -DASTRO_SOURCE_REVISION=<id>.")
  endif()
  execute_process(COMMAND git -C "${SOURCE_DIR}" status --porcelain -- src cmake tests third_party tools CMakeLists.txt CMakePresets.json
    OUTPUT_VARIABLE status RESULT_VARIABLE rc ERROR_QUIET)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "git status non riuscito in ${SOURCE_DIR}")
  endif()
  set(dirty_known "true")
  if(status STREQUAL "")
    set(dirty "false")
  else()
    set(dirty "true")
  endif()
endif()

set(content "#include \"astro/build_info.hpp\"\n\nnamespace astro::detail {\nextern const char* const kSourceRevision;\nconst char* const kSourceRevision = \"${revision}\";\nextern const bool kSourceDirtyKnown;\nconst bool kSourceDirtyKnown = ${dirty_known};\nextern const bool kSourceDirty;\nconst bool kSourceDirty = ${dirty};\n}\n")
set(existing "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
